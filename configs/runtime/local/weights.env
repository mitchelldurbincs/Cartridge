# Weights service defaults
WEIGHTS_GRPC_HOST=0.0.0.0
WEIGHTS_GRPC_PORT=8081
WEIGHTS_SHUTDOWN_TIMEOUT=15s
WEIGHTS_REGISTRY_BACKEND=memory
# WEIGHTS_REGISTRY_DSN=
WEIGHTS_HISTORY_DEPTH=2
WEIGHTS_REDIS_ENABLED=true
WEIGHTS_REDIS_ADDRESS=redis:6379
WEIGHTS_REDIS_CHANNEL=weights:updates
# WEIGHTS_REDIS_PASSWORD=
WEIGHTS_REDIS_DB=0
WEIGHTS_REDIS_TIMEOUT=2s
WEIGHTS_MIRROR_REDIS=true
WEIGHTS_METRICS_ADDRESS=:9094
WEIGHTS_TRACING_ENABLED=false
