# Cartridge local development environment variables
# Copy this file to `.env` and adjust values as needed. The defaults align with the
# Compose presets in `deployments/local/docker-compose.yml` and the sample files under
# `configs/runtime/local/`.

# Orchestrator
HOST=0.0.0.0
PORT=8080
READ_TIMEOUT=30s
WRITE_TIMEOUT=30s
SHUTDOWN_TIMEOUT=30s
DB_HOST=localhost
DB_PORT=5432
DB_USER=cartridge
DB_PASSWORD=cartridge
DB_NAME=cartridge
DB_SSL_MODE=disable
NATS_URL=nats://localhost:4222
NATS_SUBJECT=run-status
HEALTH_CHECK_INTERVAL=15s
HEARTBEAT_STALE_AFTER=45s
HEARTBEAT_UNRESPONSIVE=135s

# Replay
REPLAY_PORT=8080
REPLAY_MAX_SIZE=200000

# Engine
ENGINE_SERVER_ADDR=0.0.0.0:50051
ENGINE_METRICS_ADDR=0.0.0.0:9000

# Actor
ACTOR_ENGINE_ADDR=http://engine:50051
ACTOR_REPLAY_ADDR=http://replay:8080
ACTOR_ACTOR_ID=actor-rust-1
ACTOR_ENV_ID=tictactoe
ACTOR_MAX_EPISODES=-1
ACTOR_EPISODE_TIMEOUT=30
ACTOR_BATCH_SIZE=64
ACTOR_FLUSH_INTERVAL=5
ACTOR_LOG_LEVEL=info

# Weights
WEIGHTS_GRPC_HOST=0.0.0.0
WEIGHTS_GRPC_PORT=8081
WEIGHTS_SHUTDOWN_TIMEOUT=15s
WEIGHTS_REGISTRY_BACKEND=memory
# WEIGHTS_REGISTRY_DSN=
WEIGHTS_HISTORY_DEPTH=2
WEIGHTS_REDIS_ENABLED=true
WEIGHTS_REDIS_ADDRESS=redis:6379
WEIGHTS_REDIS_CHANNEL=weights:updates
# WEIGHTS_REDIS_PASSWORD=
WEIGHTS_REDIS_DB=0
WEIGHTS_REDIS_TIMEOUT=2s
WEIGHTS_MIRROR_REDIS=true
WEIGHTS_METRICS_ADDRESS=:9094
WEIGHTS_TRACING_ENABLED=false
